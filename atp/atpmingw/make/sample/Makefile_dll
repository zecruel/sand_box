# File: makefile
# Purpose: compile and link atp
#
CC       = gcc.exe
FOR      = g77.exe

OBJECTS =dimdef.o \
	newmods.o \
	comtac.o \
	fgnmod.o \
	usernl.o \
	analyt.o \
	devt69.o \
	usrfun.o \
	hopcod.o \
	user10.o \
	usedll.o
#	cmodels.o
#	cfun.o cmodel.o crandom.o

INSFILE	= blkcom.ins \
	comta1.ins \
	comta2.ins \
	comta3.ins \
	dekspy.ins \
	tacsar.ins \
	space2.ins

DLL_OBJS =dllfunc.o sample.o

DLL_NAME    = ../atpmingw/Dllfunc.dll
#DLL_EXP_LIB = Dllfunc.a
#DLL_EXP_DEF = Dllfunc.def

CFLAGS =  -DUNDERSCORE -O2
FFLAGS = -O2
IMAGE=../atpmingw/mytpbig.exe

LIBRARY = ../atpmingw/make/tpbig.a ../atpmingw/make/dismg7.a -lgdi32

all:	$(DLL_NAME) $(IMAGE)

.f.o:
	$(FOR) -c $(FFLAGS) $<
.c.o:
	$(CC) -c $(CFLAGS) $<

$(IMAGE) : $(OBJECTS) $(INSFILE)
	$(FOR) -s -o $(IMAGE) $(OBJECTS) $(LIBRARY)

cfun.o: ../atpmingw/make/sample/cfun.c
	$(CC) -c $(CFLAGS) \
		../atpmingw/make/sample/cfun.c

cmodel.o: ../atpmingw/make/sample/cmodel.c
	$(CC) -c $(CFLAGS) \
		../atpmingw/make/sample/cmodel.c

crandom.o: ../atpmingw/make/sample/crandom.c
	$(CC) -c $(CFLAGS) \
		../atpmingw/make/sample/crandom.c

cmodels.o: ../atpmingw/make/sample/cmodels.cpp
	$(CC) -c $(CFLAGS) \
		../atpmingw/make/sample/cmodels.cpp

dllfunc.o: ../atpmingw/make/sample/dllfunc.c
	$(CC) -c $(CFLAGS) \
		../atpmingw/make/sample/dllfunc.c

usedll.o: ../atpmingw/make/sample/usedll.c
	$(CC) -c $(CFLAGS) \
		../atpmingw/make/sample/usedll.c

sample.o: ../atpmingw/make/sample/sample.f
	$(FOR) -c $(FFLAGS) ../atpmingw/make/sample/sample.f

$(DLL_NAME): $(DLL_OBJS)
	$(CC) -shared -o $(DLL_NAME) $(DLL_OBJS) \
		-Wl,--export-all-symbols

clean:
	del ..\work\*.o
	del $(DLL_NAME)
	del $(IMAGE)
